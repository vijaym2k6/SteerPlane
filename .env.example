###############################################################################
# SteerPlane — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables have sensible defaults for local development.
###############################################################################

# ─── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_USER=steerplane
POSTGRES_PASSWORD=steerplane
POSTGRES_DB=steerplane
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ─── API Server ──────────────────────────────────────────────────────────
API_PORT=8000
DATABASE_URL=postgresql://steerplane:steerplane@localhost:5432/steerplane
DEBUG=false

# Admin token for dashboard management screens.
# If left empty, a random token is generated at startup and printed to stdout.
STEERPLANE_ADMIN_TOKEN=

# Gateway session idle timeout (seconds). Sessions without activity for this
# duration are automatically closed.
STEERPLANE_GATEWAY_SESSION_IDLE_SEC=1800

# Comma-separated list of allowed custom upstream LLM provider URLs.
# Leave empty to disable custom provider URLs.
STEERPLANE_ALLOWED_PROVIDER_URLS=

# ─── Dashboard ───────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
STEERPLANE_DASHBOARD_URL=http://localhost:3000

# ─── Email Notifications (SMTP) ─────────────────────────────────────────
STEERPLANE_SMTP_HOST=
STEERPLANE_SMTP_PORT=587
STEERPLANE_SMTP_USERNAME=
STEERPLANE_SMTP_PASSWORD=
STEERPLANE_SMTP_FROM=
STEERPLANE_SMTP_USE_TLS=true

# ─── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
