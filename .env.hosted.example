###############################################################################
# SteerPlane — settings for docker-compose.hosted.yml
#
#   cp .env.hosted.example .env.hosted
#
# Every value marked REQUIRED must be set. Never commit .env.hosted.
###############################################################################

# ─── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_USER=steerplane
# REQUIRED. Use a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
POSTGRES_PASSWORD=
POSTGRES_DB=steerplane

# ─── Admin access ────────────────────────────────────────────────────────
# REQUIRED. Used to create team API keys and to see every team's runs.
# Generate it the same way as the database password. Keep it to yourself.
STEERPLANE_ADMIN_TOKEN=

# ─── Public addresses (HTTPS, as the browser sees them) ──────────────────
# REQUIRED. Where people open the dashboard, e.g. https://app.example.com
STEERPLANE_DASHBOARD_URL=
# REQUIRED. Where the API is reachable, e.g. https://api.example.com
STEERPLANE_PUBLIC_API_URL=

# ─── Local ports (bound to 127.0.0.1; your reverse proxy forwards to them) ─
API_PORT=8000
DASHBOARD_PORT=3000

# ─── Gateway ─────────────────────────────────────────────────────────────
STEERPLANE_GATEWAY_SESSION_IDLE_SEC=1800
# Comma-separated custom upstream LLM provider URLs. Leave empty to disable.
STEERPLANE_ALLOWED_PROVIDER_URLS=
