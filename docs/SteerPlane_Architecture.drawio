        <mxCell id="degradation_note" value="Graceful Degradation: SDK enforces all&#xa;limits locally when API is unreachable.&#xa;Alert mode degrades to Kill mode." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=10;verticalAlign=middle;align=center;dashed=1;dashPattern=4 4;" vertex="1" parent="1">
